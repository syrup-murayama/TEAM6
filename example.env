# JUDGE_PROVIDER: xai | openai | anthropic
JUDGE_PROVIDER=xai

XAI_API_KEY=
XAI_JUDGE_MODEL=grok-4.6

OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-5-20250929

ELEVENLABS_API_KEY=
# Default voice is Rachel (English premade) -> accented Japanese. To upgrade,
# add a Japanese voice to "My Voices" in the ElevenLabs dashboard first, then
# set this to its Voice ID:
#   Otani (judge-like, measured):      3JDquces8E8bkmvbh6Bc
#   Ishibashi (deeper, authoritative):  Mv8AjrYZCBkdsmDHNwcB
#   Shizuka (soft, friendly):           WQz3clzUdMqvBf0jswZQ
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 (current, safe) | eleven_v3_conversational (better
# Japanese + still real-time-friendly, ~280ms) | eleven_v3 (best quality, NOT
# real-time-suitable per ElevenLabs docs)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
PORT=3000

# Demo scenario override (optional): force the "denied" path reliably by
# giving almost no buffer before the first event. Default "09:30" gives a
# ~99min buffer (reliably granted). Try "07:20" for a reliable denied demo.
DEMO_FIRST_EVENT_TIME=09:30
