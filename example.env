# JUDGE_PROVIDER: xai | openai | anthropic
JUDGE_PROVIDER=xai

XAI_API_KEY=
XAI_JUDGE_MODEL=grok-4.6

OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-5-20250929

ELEVENLABS_API_KEY=
# Chosen voice: Shizuka (soft, friendly, natively Japanese). Confirmed working
# directly via the API with no "My Voices" step needed. Other candidates that
# also worked, if a different tone is wanted later:
#   Otani (judge-like, measured):      3JDquces8E8bkmvbh6Bc
#   Ishibashi (deeper, authoritative):  Mv8AjrYZCBkdsmDHNwcB
ELEVENLABS_VOICE_ID=WQz3clzUdMqvBf0jswZQ
# eleven_v3_conversational: better Japanese naturalness than eleven_multilingual_v2
# while staying real-time-suitable (~280ms per ElevenLabs docs). Confirmed working.
ELEVENLABS_MODEL_ID=eleven_v3_conversational
PORT=3000

# Demo scenario override (optional): force the "denied" path reliably by
# giving almost no buffer before the first event. Default "09:30" gives a
# ~99min buffer (reliably granted). Try "07:20" for a reliable denied demo.
DEMO_FIRST_EVENT_TIME=09:30
